# Supabase (project config — valores publicáveis/anon, seguros para o repositório)
SUPABASE_PROJECT_ID="seu-project-id-aqui"
SUPABASE_PUBLISHABLE_KEY="sua-publishable-key-aqui"
SUPABASE_URL="https://seu-projeto.supabase.co"

# Supabase (cliente — expostos ao browser via VITE_)
VITE_SUPABASE_PROJECT_ID="seu-project-id-aqui"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-publishable-key-aqui"
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"

# Telegram bot username (cliente)
VITE_TELEGRAM_BOT_USERNAME="SeuBotUsername"

# ─────────────────────────────────────────────────────────────
# NÃO adicione ao .env do repositório os segredos de servidor abaixo.
# Eles são configurados via Secrets do Lovable (Project Settings → Secrets)
# ou do Supabase, e injetados no runtime do servidor:
#
#   SUPABASE_SERVICE_ROLE_KEY   — bypassa RLS; acesso privilegiado ao banco
#   TELEGRAM_API_KEY             — token do bot do Telegram (conector Lovable)
#   LOVABLE_API_KEY              — autenticação no gateway de conectores
# ─────────────────────────────────────────────────────────────
